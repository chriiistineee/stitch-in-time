{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stitch in Time",
  "version": "0.1.0",
  "identifier": "com.christinecruz.stitchintime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Stitch in Time",
        "width": 324,
        "height": 540,
        "minWidth": 216,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "theme": "Dark",
        "visible": false,
        "maxWidth": 540,
        "maxHeight": 900,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Christine Cruz",
    "shortDescription": "Pomodoro timer and to-do list with Stitch the dog",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
